rules_version = '2';
// Sahulat Guide: each signed-in person can read and write only their own profile.
// CNIC is never stored on the server: any write containing a "cnic" field is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && !('cnic' in request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'father', 'mobile', 'email', 'dob', 'city', 'district', 'province', 'address', 'updated'])
        && request.resource.size() < 20000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
